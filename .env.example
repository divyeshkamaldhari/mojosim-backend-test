# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
FRONTEND_ADMIN_URL=http://localhost:5174

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Mojo_sim
DB_USER=postgres
DB_PASSWORD=Admin@123

# Redis
ENABLE_REDIS=true
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-64+-char-secret
JWT_REFRESH_SECRET=replace-with-64+-char-secret

# Encryption
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Stripe
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
PENDING_ORDER_TTL_MINUTES=30

# Airalo
AIRALO_WEBHOOK_SECRET=replace

# Email (SendGrid)
SENDGRID_API_KEY=SG.replace_with_your_sendgrid_api_key
EMAIL_FROM=noreply@mojosim.com
# Optional override for email logo URL. Leave empty to use STORAGE_BASE_URL/brand/email-logo.png.
EMAIL_LOGO_URL=
ADMIN_EMAIL=admin@mojosim.com
SUPPORT_EMAIL=support@mojosim.com

# AWS S3 (avatar uploads, PDFs, etc.)
AWS_ACCESS_KEY_ID=replace
AWS_SECRET_ACCESS_KEY=replace
AWS_REGION=replace
AWS_S3_BUCKET_NAME=replace
# Optional for S3-compatible providers like DigitalOcean Spaces / MinIO
AWS_S3_ENDPOINT=
AWS_S3_BASE_URL=https://your-bucket.s3.amazonaws.com

# Storage
STORAGE_BASE_URL=http://localhost:3000/backend/medias

# Invoice PDF (generated in-process via @react-pdf/renderer)
INVOICE_ISSUER_NAME=

# Usage sync (optional; defaults match src/config/env.ts)
USAGE_SYNC_BATCH_LIMIT=100
USAGE_SYNC_MIN_INTERVAL_MINUTES=60
USAGE_SYNC_INTER_REQUEST_DELAY_MS=550

# Airalo API rate limiting & provisioning (optional)
AIRALO_RATE_LIMIT_RETRY_MS=60000
AIRALO_PROVISION_LOOKUP_POST_DELAY_MS=5000
AIRALO_MAX_REQUESTS_PER_SECOND=2
PROVISIONING_WORKER_CONCURRENCY=1
PROVISIONING_BULLMQ_ATTEMPTS=5
PROVISIONING_BULLMQ_BACKOFF_MS=60000
AIRALO_REFUND_RATE_LIMIT_MS=300000
AIRALO_REFUND_BULLMQ_ATTEMPTS=5
AIRALO_REFUND_BULLMQ_BACKOFF_MS=60000
PLAN_SYNC_PROVISIONING_QUEUE_THRESHOLD=5

# Trustpilot (optional — enables live review count/rating on the storefront)
TRUSTPILOT_API_KEY=
TRUSTPILOT_DOMAIN=mojosim.com
TRUSTPILOT_CACHE_TTL_MINUTES=60
